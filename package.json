{
  "name": "epherem-scanner",
  "version": "1.0.1",
  "description": "A free, open-source security scanner for apps built with AI tools. It reads your project's source code on your own computer, prints a report and saves nothing.",
  "license": "Apache-2.0",
  "repository": "github:Kirtikklz/epherem-scanner",
  "type": "module",
  "bin": {
    "epherem-scanner": "dist/epherem-scanner.cjs"
  },
  "files": [
    "dist/epherem-scanner.cjs",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:bundle": "node scripts/build-bundle.mjs",
    "check:bundle": "node scripts/build-bundle.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node scripts/build-bundle.mjs --check"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "22.20.0",
    "@vscode/tree-sitter-wasm": "0.3.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
