            "minimum": 0
          }
        },
        "skippedByReason": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "scanFit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reasons",
            "also"
          ],
          "properties": {
            "reasons": {
              "type": "array",
              "minItems": 0,
              "maxItems": 4,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "few_code_files",
                  "other_language",
                  "no_recognised_setup",
                  "no_package_list"
                ]
              }
            },
            "codeFilesRead": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "lead": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            },
            "also": {
              "type": "array",
              "maxItems": 3,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              }
            }
          }
        },
        "unsupportedLanguages": {
          "$ref": "#/$defs/stringArray"
        },
        "reasons": {
          "$ref": "#/$defs/stringArray"
